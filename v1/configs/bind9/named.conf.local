// /etc/bind/named.conf.local

key dhcp_updater {
    algorithm hmac-sha256;
    secret "<REDACTED-TSIG-KEY>";
};

zone "lab.lan" {
    type master;
    file "/var/lib/bind/db.lab.lan";
    allow-update { key dhcp_updater; };
};

zone "0.0.10.in-addr.arpa" {
    type master;
    file "/var/lib/bind/db.10.0.0";
    allow-update { key dhcp_updater; };
};
